	measure 'No-Show Rate' = DIVIDE ( [No-Show Appointments], [Appointments] )
		formatString: 0.0%
		displayFolder: 3 Customer
		lineageTag: c38d2679-e29b-53ab-a030-68eb9ff15e81

	measure 'Customers' = DISTINCTCOUNT ( fact_service[customer_id] )
		formatString: #,0
		displayFolder: 3 Customer
		lineageTag: 0736f9e3-fe88-595e-be88-0d64ce1b4377

	measure 'Repeat Customers' =
			COUNTROWS (
			    FILTER (
			        ADDCOLUMNS ( VALUES ( fact_service[customer_id] ), "@Orders", CALCULATE ( COUNTROWS ( fact_service ) ) ),
			        [@Orders] >= 2
			    )
			)
		formatString: #,0
		displayFolder: 3 Customer
		lineageTag: 11d36da7-51a9-5c60-a1a1-827f003db8d1

	measure 'Repeat Visit Rate' = DIVIDE ( [Repeat Customers], [Customers] )
		formatString: 0.0%
		displayFolder: 3 Customer
		lineageTag: f1c5b171-9ed5-5abe-b69e-2b6fa7edc705

	measure 'Revenue PM' = CALCULATE ( [Total Revenue], DATEADD ( DimDate[date], -1, MONTH ) )
		formatString: #,0
		displayFolder: 4 Time Intelligence
		lineageTag: 31df5d88-7895-5453-8407-188d029a92da

	measure 'Revenue MoM %' = DIVIDE ( [Total Revenue] - [Revenue PM], [Revenue PM] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Time Intelligence
		lineageTag: 9a40d1ed-ed0d-5967-adec-c0b609cfec79

	measure 'Profit PM' = CALCULATE ( [Profit], DATEADD ( DimDate[date], -1, MONTH ) )
		formatString: #,0
		displayFolder: 4 Time Intelligence
		lineageTag: 251360ef-cf33-54d8-b262-bcf44435f200

	measure 'Profit MoM %' = DIVIDE ( [Profit] - [Profit PM], [Profit PM] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Time Intelligence
		lineageTag: 7d08e816-44fb-5d6d-8b9f-12704a6178f2

	measure 'Revenue PY' = CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( DimDate[date] ) )
		formatString: #,0
		displayFolder: 4 Time Intelligence
		lineageTag: e84a93e2-f6fa-51c8-b87c-e4ee5cef3f0d

	measure 'Revenue YoY %' = DIVIDE ( [Total Revenue] - [Revenue PY], [Revenue PY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Time Intelligence
		lineageTag: c92e63aa-4d9b-5467-93db-b70d9462abb1

	measure 'Profit PY' = CALCULATE ( [Profit], SAMEPERIODLASTYEAR ( DimDate[date] ) )
		formatString: #,0
		displayFolder: 4 Time Intelligence
		lineageTag: 91aa6693-4e9c-5804-8bc2-afecd2d3db1f

	measure 'Profit YoY %' = DIVIDE ( [Profit] - [Profit PY], [Profit PY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Time Intelligence
		lineageTag: 065f2aff-6728-5471-b44e-b690e5f64992

	measure 'Revenue YTD' = TOTALYTD ( [Total Revenue], DimDate[date] )
		formatString: #,0
		displayFolder: 4 Time Intelligence
		lineageTag: 06a98663-c6c1-5e6c-bc26-12a8dbb0f31d

	measure 'INR Short Revenue' =
			VAR v = [Total Revenue]
			RETURN
			    IF (
			        ISBLANK ( v ), "-",
			        IF ( ABS ( v ) >= 10000000, FORMAT ( v / 10000000, "\₹0.0" ) & " Cr",
			        IF ( ABS ( v ) >= 100000, FORMAT ( v / 100000, "\₹0.0" ) & " L", FORMAT ( v, "\₹#,0" ) ) )
			    )
		displayFolder: 5 Display
		lineageTag: 0e93a232-9f48-5fe7-86ff-7f6a6bfa1a56

	measure 'INR Short Cost' =
			VAR v = [Total Cost]
			RETURN
			    IF (
			        ISBLANK ( v ), "-",
			        IF ( ABS ( v ) >= 10000000, FORMAT ( v / 10000000, "\₹0.0" ) & " Cr",
			        IF ( ABS ( v ) >= 100000, FORMAT ( v / 100000, "\₹0.0" ) & " L", FORMAT ( v, "\₹#,0" ) ) )
			    )
		displayFolder: 5 Display
		lineageTag: 2ea97aba-02b2-53d6-a59d-f57b032757ab

	measure 'INR Short Profit' =
			VAR v = [Profit]
			RETURN
			    IF (
			        ISBLANK ( v ), "-",
			        IF ( ABS ( v ) >= 10000000, FORMAT ( v / 10000000, "\₹0.0" ) & " Cr",
			        IF ( ABS ( v ) >= 100000, FORMAT ( v / 100000, "\₹0.0" ) & " L", FORMAT ( v, "\₹#,0" ) ) )
			    )
		displayFolder: 5 Display
		lineageTag: e6f42238-4338-52bc-90cd-24b9f48d97de

	measure 'Centre Performance Index' =
			VAR Centres = ALLSELECTED ( DimCentre[center_name] )
			VAR N = COUNTROWS ( Centres )
			VAR RankOnTime = RANKX ( Centres, [On-Time %], , ASC, Skip )
			VAR RankRating = RANKX ( Centres, [Avg Rating], , ASC, Skip )
			VAR RankMargin = RANKX ( Centres, [Profit Margin %], , ASC, Skip )
			VAR RankTurn = RANKX ( Centres, [Avg Turnaround Hours], , DESC, Skip )
			VAR RankCancel = RANKX ( Centres, [Cancellation Rate], , DESC, Skip )
			RETURN
			    IF (
			        HASONEVALUE ( DimCentre[center_name] ),
			        100 * DIVIDE ( RankOnTime + RankRating + RankMargin + RankTurn + RankCancel, 5 * N )
			    )
		formatString: 0
		displayFolder: 6 Ranking
		lineageTag: dc2e502c-bb2c-57fe-80e6-e1803770cd85

	measure 'Centre Rank' =
			IF (
			    HASONEVALUE ( DimCentre[center_name] ),
			    RANKX ( ALLSELECTED ( DimCentre[center_name] ), [Centre Performance Index], , DESC, Skip )
			)
		formatString: 0
		displayFolder: 6 Ranking
		lineageTag: 805ab29d-3065-5ac7-a8e7-6d6ac32416af

	measure 'Key Insight - Executive' =
			VAR T = ADDCOLUMNS ( VALUES ( DimCentre[center_name] ), "@OnTime", [On-Time %] )
			VAR Worst = TOPN ( 1, FILTER ( T, NOT ISBLANK ( [@OnTime] ) ), [@OnTime], ASC )
			RETURN
			    IF (
			        COUNTROWS ( T ) < 2,
			        BLANK (),
			        MAXX ( Worst, DimCentre[center_name] ) & " has the lowest on-time rate at "
			            & FORMAT ( MINX ( Worst, [@OnTime] ), "0.0%" ) & " (network " & FORMAT ( [On-Time %], "0.0%" ) & ")."
			    )
		displayFolder: 6 Ranking
		lineageTag: 4f3a3524-20d9-59f6-8e6f-a8690c33b1d1

	measure 'Key Insight - Operations' =
			VAR T = ADDCOLUMNS ( VALUES ( DimCentre[center_name] ), "@Turn", [Avg Turnaround Hours] )
			VAR Slowest = TOPN ( 1, FILTER ( T, NOT ISBLANK ( [@Turn] ) ), [@Turn], DESC )
			RETURN
			    IF (
			        COUNTROWS ( T ) < 2,
			        BLANK (),
			        MAXX ( Slowest, DimCentre[center_name] ) & " is slowest, averaging "
			            & FORMAT ( MAXX ( Slowest, [@Turn] ), "0.0" ) & " h turnaround."
			    )
		displayFolder: 6 Ranking
		lineageTag: 2acdfd6c-020e-5d61-ad3a-4e1aa85f02ec

	measure 'Key Insight - Financial' =
			VAR T = ADDCOLUMNS ( VALUES ( DimServiceType[service_type] ), "@Margin", [Profit Margin %] )
			VAR Best = TOPN ( 1, FILTER ( T, NOT ISBLANK ( [@Margin] ) ), [@Margin], DESC )
			VAR Worst = TOPN ( 1, FILTER ( T, NOT ISBLANK ( [@Margin] ) ), [@Margin], ASC )
			RETURN
			    IF (
			        COUNTROWS ( T ) < 2,
			        BLANK (),
			        MAXX ( Best, DimServiceType[service_type] ) & " earns the best margin (" & FORMAT ( MAXX ( Best, [@Margin] ), "0.0%" )
			            & ") while " & MAXX ( Worst, DimServiceType[service_type] ) & " earns the lowest ("
			            & FORMAT ( MAXX ( Worst, [@Margin] ), "0.0%" ) & ")."
			    )
		displayFolder: 6 Ranking
		lineageTag: 8c7e0b71-73e5-5a85-821f-4b579c365a8e

	measure 'Key Insight - Customer' =
			VAR T = ADDCOLUMNS ( VALUES ( DimCentre[center_name] ), "@Rating", [Avg Rating] )
			VAR Lowest = TOPN ( 1, FILTER ( T, NOT ISBLANK ( [@Rating] ) ), [@Rating], ASC )
			RETURN
			    IF (
			        COUNTROWS ( T ) < 2,
			        BLANK (),
			        MAXX ( Lowest, DimCentre[center_name] ) & " has the lowest average rating ("
			            & FORMAT ( MINX ( Lowest, [@Rating] ), "0.00" ) & " / 5)."
			    )
		displayFolder: 6 Ranking
		lineageTag: 8dee123e-fe81-52ef-b414-e28ebecebf7b

	measure 'Selection Label' =
			VAR Centre =
			    IF ( ISFILTERED ( DimCentre[center_name] ),
			         IF ( HASONEVALUE ( DimCentre[center_name] ), SELECTEDVALUE ( DimCentre[center_name] ), "Selected centres" ),
			         "All centres" )
			VAR Region =
			    IF ( ISFILTERED ( DimCentre[region] ),
			         IF ( HASONEVALUE ( DimCentre[region] ), SELECTEDVALUE ( DimCentre[region] ), "Selected regions" ),
			         "All regions" )
			VAR D0 = MIN ( DimDate[date] )
			VAR D1 = MAX ( DimDate[date] )
			RETURN
			    Centre & " | " & Region & " | " & FORMAT ( D0, "dd mmm yyyy" ) & " - " & FORMAT ( D1, "dd mmm yyyy" )
		displayFolder: 7 Titles
		lineageTag: 59c31b32-eaef-500e-80da-8fc699038f58

	measure 'Title - Revenue and Profit Trend' = "Monthly revenue and profit - " & [Selection Label]
		displayFolder: 7 Titles
		lineageTag: 7877c234-2e68-5a69-b31e-0203db078306

	measure 'Title - Turnaround by Centre' = "Turnaround time by centre (hours) - " & [Selection Label]
		displayFolder: 7 Titles
		lineageTag: a8ce53c8-d525-5e41-aa63-7fd55af88fe4

	measure 'Title - Profit by Centre' = "Profit by service centre - " & [Selection Label]
		displayFolder: 7 Titles
		lineageTag: 66eb216e-03d9-5d35-a5ad-2987c2a0a215

	measure 'Title - Rating Trend' = "Rating trend - " & [Selection Label]
		displayFolder: 7 Titles
		lineageTag: e3aaec63-82cf-5e2c-a051-c8cfda0e6099

	measure 'Footer Disclaimer' = "Synthetic data for demonstration. Modelled on an EV two-wheeler service network; not affiliated with Ather Energy. Amounts in INR."
		displayFolder: 7 Titles
		lineageTag: de06cd4e-8674-5cf6-ae96-d9054b3f9460

	measure 'Colour - On-Time vs Network' =
			VAR Network = CALCULATE ( [On-Time %], ALLSELECTED ( DimCentre ) )
			RETURN IF ( [On-Time %] >= Network, "#00A67E", "#EB6834" )
		displayFolder: 7 Titles
		lineageTag: a93fa31f-0e95-5289-b433-d40a44f472b8

	measure 'Colour - Profit Sign' = IF ( [Profit] >= 0, "#00A67E", "#EB6834" )
		displayFolder: 7 Titles
		lineageTag: b33e7ebe-785c-5afe-af5c-f175937f46f8

	measure 'Colour - Skill Level' =
			SWITCH (
			    SELECTEDVALUE ( DimTechnician[skill_level] ),
			    "Junior", "#EB6834",
			    "Mid", "#2A78D6",
			    "Senior", "#00A67E",
			    "Master", "#4A3AA7",
			    "#A9B4B0"
			)
		displayFolder: 7 Titles
		lineageTag: 76f49889-0e28-5993-b779-b2fc47414d82

	column 'Measure Holder'
		dataType: string
		isHidden
		lineageTag: b2879795-129b-5d52-974c-8121ef6f9aa1
		summarizeBy: none
		sourceColumn: Measure Holder

		annotation SummarizationSetBy = Automatic

	partition '_Measures' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Measure Holder" = text], {})
				in
				    Source

	annotation PBI_ResultType = Table
