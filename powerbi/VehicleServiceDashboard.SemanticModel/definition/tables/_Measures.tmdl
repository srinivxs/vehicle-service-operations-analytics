		displayFolder: 3 Customer
		lineageTag: 5d1671e5-8870-5ee7-91f6-92bec04d88b9

	measure 'Cancelled Appointments' = CALCULATE ( COUNTROWS ( fact_appointments ), fact_appointments[status] = "Cancelled" )
		formatString: #,0
		displayFolder: 3 Customer
