table '_Measures'
	lineageTag: 4491e3d9-f222-571a-b7d3-4c30698a48de

	measure 'Total Revenue' = SUM ( fact_service[revenue] )
		formatString: #,0
		displayFolder: 1 Financial
		lineageTag: a3d853d6-0784-57ef-9705-dc0cedd1193f

	measure 'Labour Cost' = SUM ( fact_service[labor_cost] )
		formatString: #,0
		displayFolder: 1 Financial
		lineageTag: 48def844-0786-5624-bc51-8daa75b867b8

	measure 'Parts Cost' = SUM ( fact_service[parts_cost] )
		formatString: #,0
		displayFolder: 1 Financial
		lineageTag: 928f4754-031f-5c4a-8ae0-142862caed30

	measure 'Total Cost' = [Labour Cost] + [Parts Cost]
		formatString: #,0
		displayFolder: 1 Financial
		lineageTag: 96a0bffb-15d3-5475-9178-1295d2c43e38

	measure 'Profit' = [Total Revenue] - [Total Cost]
		formatString: #,0
		displayFolder: 1 Financial
		lineageTag: 77665900-ca3d-5033-8e40-6fc424215e81

	measure 'Profit Margin %' = DIVIDE ( [Profit], [Total Revenue] )
		formatString: 0.0%
		displayFolder: 1 Financial
		lineageTag: 6f3a94dd-6eb7-5699-a4b6-aad7b816afe1

	measure 'Avg Service Cost' = DIVIDE ( [Total Cost], [Completed Services] )
		formatString: #,0
		displayFolder: 1 Financial
		lineageTag: a4211618-f6a2-5018-8946-d506989c771c

	measure 'Parts Share of Cost %' = DIVIDE ( [Parts Cost], [Total Cost] )
		formatString: 0.0%
		displayFolder: 1 Financial
		lineageTag: 3e1fa553-d19d-5b05-919f-c81370c995a2

	measure 'Total Estimated Cost' = SUM ( fact_service[estimated_cost] )
		formatString: #,0
		displayFolder: 1 Financial
		lineageTag: 0fb1c962-886e-5457-b662-5adaf94f6958

	measure 'Cost Variance' = SUM ( fact_service[cost_variance] )
		formatString: #,0
		displayFolder: 1 Financial
		lineageTag: 6e8834e5-b09c-5faf-843b-5fd266fead7b

	measure 'Cost Variance %' = DIVIDE ( [Cost Variance], [Total Estimated Cost] )
		formatString: 0.0%
		displayFolder: 1 Financial
		lineageTag: 0a7f3779-8681-527f-9a80-6511acbb0251

	measure 'Cost Overrun Rate' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_service ), fact_service[cost_overrun_flag] = TRUE () ),
			    [Completed Services]
			)
		formatString: 0.0%
		displayFolder: 1 Financial
		lineageTag: ebaa9187-c700-5456-b37c-3ca69037c4d7

	measure 'Parts Cost (Catalogue)' = SUMX ( part_usage, part_usage[quantity] * RELATED ( parts[unit_cost] ) )
		formatString: #,0
		displayFolder: 1 Financial
		lineageTag: 4cfe33e9-827e-5666-b907-0b3779db29a1

	measure 'Completed Services' = COUNTROWS ( fact_service )
		formatString: #,0
		displayFolder: 2 Operations
		lineageTag: 815244bd-823b-575c-be64-94f098805362

	measure 'On-Time %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_service ), fact_service[on_time_flag] = TRUE () ),
