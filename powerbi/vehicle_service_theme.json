{
  "name": "Vehicle Service Analytics",
  "dataColors": ["#00A67E", "#2A78D6", "#EB6834", "#4A3AA7", "#E87BA4", "#EDA100", "#A9B4B0", "#1F2A27"],
  "background": "#FFFFFF",
  "foreground": "#1F2A27",
  "tableAccent": "#00A67E",
  "good": "#00A67E",
  "neutral": "#EDA100",
  "bad": "#EB6834",
  "maximum": "#00573F",
  "center": "#86D6C0",
  "minimum": "#E6F6F1",
  "null": "#C9D1CE",
  "firstLevelElements": "#1F2A27",
  "secondLevelElements": "#52605B",
  "thirdLevelElements": "#E6EBE9",
  "fourthLevelElements": "#C9D1CE",
  "secondaryBackground": "#F4F7F6",
  "tertiaryBackground": "#E6EBE9",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F2A27" },
    "title": { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#1F2A27" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2A27" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52605B" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2A27" } }, "fontSize": 13, "alignment": "left" }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "visualHeader": [{ "show": true }],
        "categoryAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#8A9691" } }, "lineColor": { "solid": { "color": "#C9D1CE" } }, "fontSize": 10 }],
        "valueAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#8A9691" } }, "fontSize": 10 }],
        "gridlines": [{ "show": true, "color": { "solid": { "color": "#E6EBE9" } }, "strokeWidth": 1 }],
        "legend": [{ "show": true, "position": "TopRight", "labelColor": { "solid": { "color": "#52605B" } }, "fontSize": 10 }],
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#00A67E" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F7F6" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F7F6" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontSize": 28, "color": { "solid": { "color": "#1F2A27" } } }],
        "categoryLabels": [{ "show": true, "fontSize": 11, "color": { "solid": { "color": "#52605B" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E6EBE9" } }, "radius": 6 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#1F2A27" } }, "fontSize": 11 }],
        "items": [{ "fontColor": { "solid": { "color": "#52605B" } }, "fontSize": 10 }],
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "showMarker": false }],
        "markers": [{ "show": false }]
      }
    },
    "clusteredBarChart": { "*": { "categoryAxis": [{ "showAxisTitle": false }], "labels": [{ "show": true, "color": { "solid": { "color": "#52605B" } }, "fontSize": 10 }] } },
    "clusteredColumnChart": { "*": { "labels": [{ "show": false }] } },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#1F2A27" } }, "backColor": { "solid": { "color": "#F4F7F6" } }, "fontSize": 10, "bold": true }],
        "values": [{ "fontColor": { "solid": { "color": "#1F2A27" } }, "fontSize": 10 }],
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E6EBE9" } }, "gridVertical": false, "outlineColor": { "solid": { "color": "#E6EBE9" } } }]
      }
    }
  }
}
